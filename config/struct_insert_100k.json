{
  "_comment": [
    "Single-algorithm config for structural dumping of INSERT.",
    "INSERT does NOT route through merge_pair, so the NGMBENCH_DUMP_DIR hook does",
    "not catch it. Instead this uses a DEDICATED empty workdir so that after the run",
    "exactly one produced .hnsw exists - dump that one directly, no uuid guessing:",
    "  python -m ngmbench.cli_cpp --config config/struct_insert_100k.json",
    "  ls .work_insert100k/*.hnsw   # find the produced index",
    "  ./dump_graph .work_insert100k/<that>.hnsw 128 dumps/INSERT_100k.csv",
    "Its own workdir + results file so it collides with nothing else.",
    "INSERT logs null recall (returns before eval) - expected, not a failure."
  ],
  "binaries": {
    "builds": "$HNSWMERGER_BIN/builds",
    "exps": "$HNSWMERGER_BIN/exps"
  },
  "dataset": {
    "name": "bigann100k",
    "dim": 128,
    "nb": 100000,
    "base": "data/sift_scales/sift100k_base.fvecs",
    "query": "data/sift_scales/sift_query.fvecs",
    "groundtruth": "data/sift_scales/sift100k_gt.ivecs"
  },
  "hnsw": {
    "M": 16,
    "ef_construction": 200
  },
  "eval": {
    "k": 10,
    "kk": 100,
    "nq": 10000,
    "efs_array": [
      10,
      50,
      100,
      200,
      400
    ]
  },
  "threads": 1,
  "workdir": ".work_insert100k",
  "results_path": "results/struct_insert100k.jsonl",
  "sweep": [
    {
      "algo": [
        "INSERT"
      ],
      "n_parts": [
        1
      ],
      "order": [
        "balanced"
      ],
      "params": [
        {}
      ]
    }
  ]
}