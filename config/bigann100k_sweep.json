{
  "_comment": [
    "100k sweep: merge-parameter grid + ef_construction axis, all at n_parts=2.",
    "ef_construction is the biggest untested lever on the merge-vs-SIGM verdict:",
    "SIGM IS insertion so its cost scales with efc, while the traversal merges'",
    "cost is set by jump_ef/local_ef and is largely efc-independent. We run 200;",
    "the SIGMOD paper uses 64; Ponomarenko's public bench uses 32. Sweeping it",
    "here is far cheaper than at 1M and tests whether the ordering is stable.",
    "NOTE: leaves are cached per (lrange, rrange, M, efc), so each efc point",
    "rebuilds its own leaves - that is correct, not waste."
  ],
  "binaries": {
    "builds": "$HNSWMERGER_BIN/builds",
    "exps": "$HNSWMERGER_BIN/exps"
  },
  "dataset": {
    "name": "bigann100k",
    "dim": 128,
    "nb": 100000,
    "base": "data/sift_scales/sift100k_base.fvecs",
    "query": "data/sift_scales/sift_query.fvecs",
    "groundtruth": "data/sift_scales/sift100k_gt.ivecs"
  },
  "hnsw": {
    "M": 16,
    "ef_construction": 200
  },
  "eval": {
    "k": 10,
    "kk": 100,
    "nq": 10000,
    "efs_array": [
      10,
      50,
      100,
      200,
      400
    ]
  },
  "threads": 1,
  "workdir": ".work_bigann100k",
  "results_path": "results/bigann100k.jsonl",
  "sweep": [
    {
      "algo": [
        "IGTM"
      ],
      "n_parts": [
        2
      ],
      "order": [
        "balanced"
      ],
      "params": [
        {
          "jump_ef": 40,
          "local_ef": 10,
          "next_step_k": 6,
          "next_step_ef": 6,
          "search_M": 40
        },
        {
          "jump_ef": 20,
          "local_ef": 5,
          "next_step_k": 3,
          "next_step_ef": 3,
          "search_M": 3
        },
        {
          "jump_ef": 64,
          "local_ef": 5,
          "next_step_k": 3,
          "next_step_ef": 3,
          "search_M": 5
        },
        {
          "jump_ef": 5,
          "local_ef": 7,
          "next_step_k": 3,
          "next_step_ef": 3,
          "search_M": 5
        }
      ]
    },
    {
      "algo": [
        "CGTM"
      ],
      "n_parts": [
        2
      ],
      "order": [
        "balanced"
      ],
      "params": [
        {
          "jump_ef": 40,
          "local_ef": 10,
          "next_step_k": 6,
          "search_M": 40
        },
        {
          "jump_ef": 20,
          "local_ef": 5,
          "next_step_k": 3,
          "search_M": 3
        },
        {
          "jump_ef": 15,
          "local_ef": 5,
          "next_step_k": 3,
          "search_M": 5
        }
      ]
    },
    {
      "algo": [
        "NGM"
      ],
      "n_parts": [
        2
      ],
      "order": [
        "balanced"
      ],
      "params": [
        {
          "search_ef": 40
        },
        {
          "search_ef": 20
        },
        {
          "search_ef": 10
        }
      ]
    },
    {
      "algo": [
        "TWO_MERGE"
      ],
      "n_parts": [
        2
      ],
      "order": [
        "balanced"
