{
  "_comment": [
    "10k SMOKE TEST - not a result. One param point per algorithm, ~seconds to run.",
    "Purpose: exercise every piece of wiring at once (C++ patches, merge_kv splat,",
    "run_key discrimination, d_s parsing, HNSWMerger instrumentation) before",
    "committing to the 100k sweep.",
    "Expected non-bug at this scale: leaves are 5000 points with ef_construction=200,",
    "so the graphs are near-complete and recall pins near 1.0 - d_s@0.95 may come",
    "back null because the curve never brackets 0.95. That is the small-scale",
    "degeneracy, not a wiring fault. It should resolve at 100k."
  ],
  "binaries": {
    "builds": "$HNSWMERGER_BIN/builds",
    "exps": "$HNSWMERGER_BIN/exps"
  },
  "dataset": {
    "name": "bigann10k",
    "dim": 128,
    "nb": 10000,
    "base": "data/sift_scales/sift10k_base.fvecs",
    "query": "data/sift_scales/sift_query.fvecs",
    "groundtruth": "data/sift_scales/sift10k_gt.ivecs"
  },
  "hnsw": {
    "M": 16,
    "ef_construction": 200
  },
  "eval": {
    "k": 10,
    "kk": 100,
    "nq": 10000,
    "efs_array": [
      10,
      50,
      100,
      200,
      400
    ]
  },
  "threads": 1,
  "workdir": ".work_bigann10k",
  "results_path": "results/bigann10k.jsonl",
  "sweep": [
    {
      "algo": [
        "IGTM"
      ],
      "n_parts": [
        2
      ],
      "order": [
        "balanced"
      ],
      "params": [
        {
          "jump_ef": 5,
          "local_ef": 7,
          "next_step_k": 3,
          "next_step_ef": 3,
          "search_M": 5
        }
      ]
    },
    {
      "algo": [
        "CGTM"
      ],
      "n_parts": [
        2
      ],
      "order": [
        "balanced"
      ],
      "params": [
        {
          "jump_ef": 15,
          "local_ef": 5,
          "next_step_k": 3,
          "search_M": 5
        }
      ]
    },
    {
      "algo": [
        "NGM"
      ],
      "n_parts": [
        2
      ],
      "order": [
        "balanced"
      ],
      "params": [
        {
          "search_ef": 40
        }
      ]
    },
    {
      "algo": [
        "TWO_MERGE"
      ],
      "n_parts": [
        2
      ],
      "order": [
        "balanced"
      ],
      "params": [
        {
          "merge_lambda": 4
        }
      ]
    },
    {
      "algo": [
        "SIGM"
      ],
      "n_parts": [
        2
      ],
      "order": [
        "balanced"
      ],
      "params": [
        {
          "merge_ef_construction": -1
        }
      ]
    },
    {
      "algo": [
        "INSERT"
      ],
      "n_parts": [
        1
      ],
      "order": [
        "balanced"
      ],
      "params": [
        {}
      ]
    }
  ]
}