{
  "_comment": [
    "1m sweep for turing (dim 100, L2): merge-parameter grid + ef_construction",
    "axis at n_parts=2, mirroring the SIFT template. Ground truth is exact L2",
    "k-NN of the query set within this N-prefix (prepare_dataset.py).",
    "Workload maps to TURING1M in test_config.h via dim=100."
  ],
  "binaries": {
    "builds": "$HNSWMERGER_BIN/builds",
    "exps": "$HNSWMERGER_BIN/exps"
  },
  "dataset": {
    "name": "turing1m",
    "dim": 100,
    "nb": 1000000,
    "base": "data/turing_scales/turing1m_base.fvecs",
    "query": "data/turing_scales/turing_query.fvecs",
    "groundtruth": "data/turing_scales/turing1m_gt.ivecs"
  },
  "hnsw": {
    "M": 16,
    "ef_construction": 200
  },
  "eval": {
    "k": 10,
    "kk": 100,
    "nq": 10000,
    "efs_array": [
      10,
      50,
      100,
      200,
      400
    ]
  },
  "threads": 1,
  "workdir": ".work_turing1m",
  "results_path": "results/turing1m.jsonl",
