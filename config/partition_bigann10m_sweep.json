{
  "_comment": [
    "Partition-scaling sweep for SIFT 10m: canonical config per strategy,",
    "n_parts in [2,4,8,16], balanced D&C merge. cleanup_merged=true so",
    "intermediate indices (15 at P=16) are deleted as consumed.",
    "INSERT P=1 is the monolithic baseline. Feeds fig_partition_scaling."
  ],
  "binaries": {
    "builds": "$HNSWMERGER_BIN/builds",
    "exps": "$HNSWMERGER_BIN/exps"
  },
  "dataset": {
    "name": "bigann10m",
    "dim": 128,
    "nb": 10000000,
    "base": "data/sift_scales/sift10m_base.fvecs",
    "query": "data/sift_scales/sift_query.fvecs",
    "groundtruth": "data/sift_scales/sift10m_gt.ivecs"
  },
  "hnsw": {
    "M": 16,
    "ef_construction": 200
  },
  "eval": {
    "k": 10,
    "kk": 100,
    "nq": 10000,
    "efs_array": [
      10,
      50,
      100,
      200,
      400
    ]
  },
  "threads": 1,
  "workdir": ".work_partsweep_10m",
  "results_path": "results/partition_bigann10m.jsonl",
  "sweep": [
    {
      "_block": "monolithic baseline",
      "algo": [
        "INSERT"
      ],
      "n_parts": [
        1
      ],
      "order": [
        "balanced"
      ],
      "params": [
        {}
      ]
    },
    {
      "_block": "IGTM partition scaling",
      "algo": [
        "IGTM"
      ],
      "n_parts": [
        2,
        4,
        8,
        16
      ],
      "order": [
        "balanced"
      ],
      "params": [
        {
          "jump_ef": 5,
          "local_ef": 7,
          "next_step_k": 3,
          "next_step_ef": 3,
          "search_M": 5
        }
      ]
    },
    {
      "_block": "CGTM partition scaling",
      "algo": [
        "CGTM"
      ],
      "n_parts": [
        2,
        4,
        8,
        16
      ],
      "order": [
        "balanced"
      ],
      "params": [
        {
          "jump_ef": 15,
          "local_ef": 5,
          "next_step_k": 3,
          "next_step_ef": 6,
          "search_M": 5
        }
      ]
    },
    {
      "_block": "NGM partition scaling",
      "algo": [
        "NGM"
      ],
      "n_parts": [
        2,
        4,
        8,
        16
      ],
      "order": [
        "balanced"
      ],
      "params": [
        {
          "search_ef": 10
        }
      ]
    },
    {
      "_block": "TWO_MERGE partition scaling",
      "algo": [
        "TWO_MERGE"
      ],
      "n_parts": [
        2,
        4,
        8,
        16
      ],
      "order": [
        "balanced"
      ],
      "params": [
        {
          "merge_lambda": 4
        }
      ]
    },
    {
      "_block": "SIGM partition scaling",
      "algo": [
        "SIGM"
      ],
      "n_parts": [
        2,
        4,
        8,
        16
      ],
      "order": [
        "balanced"
      ],
      "params": [
        {
          "merge_ef_construction": -1
        }
      ]
    }
  ],
  "cleanup_merged": true
}