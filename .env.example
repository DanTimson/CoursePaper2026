# The C++ backend is not vendored — see cpp/README.md to build it.
export HNSWMERGER_BIN=/path/to/HNSWMerger/HNSW-Merger

# Optional: where structural graph dumps are written when set (used by the
# level-0 dump hook in ngmbench/index/hnswmerger.py). Defaults to ./dumps.
# export NGMBENCH_DUMP_DIR=dumps

# FastKCNA is also external — see cpp/FASTKCNA.md.
export FASTKCNA_ROOT=/path/to/FastKCNA
# Optional if binaries are not under $FASTKCNA_ROOT/code:
# export FASTKCNA_BUILD_INDEX=/path/to/build_index
# export FASTKCNA_FVEC2LSHKIT=/path/to/fvec2lshkit
